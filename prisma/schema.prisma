// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum ContentStatus {
  DRAFT       // Giáo viên đang soạn
  PENDING     // Chờ admin duyệt
  PUBLISHED   // Đã công bố
  ARCHIVED    // Lưu trữ
}

enum Skill {
  READING
  LISTENING
  WRITING
  SPEAKING
  GRAMMAR
  VOCABULARY
}

enum QuestionType {
  MULTIPLE_CHOICE       // Trắc nghiệm 1 đáp án
  MULTIPLE_SELECT       // Trắc nghiệm nhiều đáp án
  FILL_IN_BLANK         // Điền từ vào chỗ trống
  MATCHING              // Nối cặp
  ORDERING              // Sắp xếp câu/từ
  SHORT_ANSWER          // Trả lời ngắn (chấm tay)
  AUDIO_RESPONSE        // Nói/phát âm (chấm bằng Whisper)
  READING_COMPREHENSION // Đọc hiểu (có đoạn văn)
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ExamType {
  MINI_TEST         // Kiểm tra nhanh 10–15 câu
  GRAMMAR_QUIZ      // Ôn ngữ pháp theo bài học
  SKILL_PRACTICE    // Luyện 1 kỹ năng cụ thể
  MID_TERM          // Kiểm tra giữa kỳ
  FINAL_EXAM        // Thi cuối kỳ
  NATIONAL_MOCK     // Thi thử THPT quốc gia
  CUSTOM            // Giáo viên tự định nghĩa cấu trúc
}

enum BadgeType {
  STREAK            // Chuỗi ngày học
  MASTERY           // Hoàn thành chủ đề
  SCORE             // Đạt điểm cao
  SPEED             // Làm bài nhanh
  CONSISTENCY       // Học đều đặn
}

// ============================================================
// AUTH & USER
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // null nếu dùng OAuth
  role          Role      @default(STUDENT)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Thông tin thêm
  grade         Int?      // Lớp: 10, 11, 12 (chỉ học sinh)
  school        String?   // Tên trường
  bio           String?   // Giới thiệu (giáo viên)

  // Relations
  accounts        Account[]
  sessions        Session[]
  enrollments     Enrollment[]
  lessonProgress  LessonProgress[]
  flashcardReviews FlashcardReview[]
  examAttempts    ExamAttempt[]
  userXP          UserXP?
  userBadges      UserBadge[]
  streak          Streak?
  createdLessons  Lesson[]        @relation("LessonAuthor")
  createdExams    Exam[]          @relation("ExamAuthor")
  createdQuestions Question[]     @relation("QuestionAuthor")

  @@map("users")
}

// NextAuth — OAuth accounts
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// NextAuth — Sessions
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ============================================================
// NỘI DUNG HỌC
// ============================================================

// Chủ đề (ví dụ: Unit 1 - Family, Grammar - Tenses)
model Topic {
  id          String        @id @default(cuid())
  title       String
  description String?
  thumbnail   String?       // URL ảnh đại diện
  order       Int           @default(0) // Thứ tự hiển thị
  grade       Int           // 10, 11, hoặc 12
  skill       Skill?        // null = chủ đề tổng hợp
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]

  @@map("topics")
}

// Bài học trong một chủ đề
model Lesson {
  id          String        @id @default(cuid())
  topicId     String
  authorId    String        // Giáo viên soạn
  title       String
  description String?
  thumbnail   String?
  order       Int           @default(0)
  duration    Int?          // Thời gian ước tính (phút)
  skill       Skill
  difficulty  Difficulty    @default(MEDIUM)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  topic       Topic          @relation(fields: [topicId], references: [id])
  author      User           @relation("LessonAuthor", fields: [authorId], references: [id])
  contents    LessonContent[]
  vocabularies Vocabulary[]
  progress    LessonProgress[]
  examQuestions ExamQuestion[] // Câu hỏi ôn tập thuộc bài học này

  @@index([topicId, status])
  @@index([skill, difficulty])
  @@map("lessons")
}

// Nội dung chi tiết của bài học (blocks)
// Mỗi bài học có nhiều blocks theo thứ tự
model LessonContent {
  id        String   @id @default(cuid())
  lessonId  String
  order     Int
  type      String   // "text" | "image" | "video" | "audio" | "flashcard_set"
  content   Json     // Nội dung linh hoạt theo type:
  // type="text"         → { html: string }
  // type="image"        → { url: string, caption: string }
  // type="video"        → { url: string, youtubeId?: string, title: string }
  // type="audio"        → { url: string, transcript: string, duration: number }
  // type="flashcard_set"→ { cards: [{front,back,example}] }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_contents")
}

// Từ vựng trong bài học (dùng cho flashcard)
model Vocabulary {
  id           String   @id @default(cuid())
  lessonId     String
  word         String
  pronunciation String? // /prəˌnʌnsiˈeɪʃn/
  partOfSpeech String?  // n., v., adj., adv.
  definition   String   // Nghĩa tiếng Việt
  example      String?  // Câu ví dụ tiếng Anh
  imageUrl     String?  // Hình minh họa
  audioUrl     String?  // File âm thanh phát âm
  createdAt    DateTime @default(now())

  lesson          Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  flashcardReviews FlashcardReview[]

  @@map("vocabularies")
}

// ============================================================
// NGÂN HÀNG CÂU HỎI
// ============================================================

model Question {
  id           String       @id @default(cuid())
  authorId     String
  skill        Skill
  type         QuestionType
  difficulty   Difficulty   @default(MEDIUM)
  content      Json         // Nội dung câu hỏi:
  // MULTIPLE_CHOICE/SELECT:
  //   { text: string, imageUrl?: string, audioUrl?: string }
  // FILL_IN_BLANK:
  //   { text: string, blanks: number }  (dùng [BLANK] làm placeholder)
  // MATCHING:
  //   { leftItems: string[], rightItems: string[] }
  // ORDERING:
  //   { items: string[], instruction: string }
  // READING_COMPREHENSION:
  //   { passage: string, passageAudioUrl?: string, question: string }
  // AUDIO_RESPONSE:
  //   { prompt: string, targetText: string }  (targetText để so sánh phát âm)

  explanation  String?      // Giải thích đáp án
  tags         String[]     // Tags để tìm kiếm: ["present-tense", "unit-3"]
  status       ContentStatus @default(DRAFT)
  points       Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  author       User              @relation("QuestionAuthor", fields: [authorId], references: [id])
  options      QuestionOption[]
  examQuestions ExamQuestion[]
  answers      AttemptAnswer[]

  @@index([skill, type, difficulty])
  @@index([status, authorId])
  @@map("questions")
}

// Các lựa chọn của câu hỏi (cho MULTIPLE_CHOICE, MULTIPLE_SELECT, MATCHING)
model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  text       String
  imageUrl   String?
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
  matchKey   String?  // Cho MATCHING: key để nối cặp

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_options")
}

// ============================================================
// ĐỀ THI
// ============================================================

model Exam {
  id           String     @id @default(cuid())
  authorId     String
  title        String
  description  String?
  type         ExamType
  grade        Int        // 10, 11, 12
  duration     Int        // Thời gian làm bài (phút)
  totalPoints  Int        @default(0) // Tổng điểm, tự tính
  passingScore Int?       // Điểm đạt (nếu có)
  status       ContentStatus @default(DRAFT)
  isPublic     Boolean    @default(false) // Cho học sinh tự làm không cần giao
  startAt      DateTime?  // Mở làm từ lúc này (null = luôn mở)
  endAt        DateTime?  // Đóng làm sau lúc này
  maxAttempts  Int?       // Số lần làm tối đa (null = không giới hạn)
  showResult   Boolean    @default(true)  // Hiện kết quả ngay sau nộp
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  author       User           @relation("ExamAuthor", fields: [authorId], references: [id])
  sections     ExamSection[]
  attempts     ExamAttempt[]
  assignedTo   ExamAssignment[]

  @@map("exams")
}

// Phần/section trong đề thi (ví dụ: Part 1 - Listening, Part 2 - Grammar)
model ExamSection {
  id           String   @id @default(cuid())
  examId       String
  title        String   // "Part 1: Listening Comprehension"
  instruction  String?  // Hướng dẫn cho phần này
  order        Int
  skill        Skill?
  timeLimit    Int?     // Thời gian riêng cho phần này (phút)

  exam         Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions    ExamQuestion[]

  @@map("exam_sections")
}

// Câu hỏi trong đề thi (bridge table với metadata)
model ExamQuestion {
  id         String  @id @default(cuid())
  sectionId  String
  questionId String
  lessonId   String? // Thuộc bài học nào (tùy chọn)
  order      Int
  points     Int     @default(1) // Override điểm của câu hỏi gốc

  section    ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id])
  lesson     Lesson?     @relation(fields: [lessonId], references: [id])

  @@unique([sectionId, questionId])
  @@map("exam_questions")
}

// Giao đề thi cho lớp/học sinh cụ thể
model ExamAssignment {
  id        String   @id @default(cuid())
  examId    String
  userId    String?  // null = giao cho toàn bộ theo grade
  grade     Int?     // null = giao cho userId cụ thể
  createdAt DateTime @default(now())

  exam      Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("exam_assignments")
}

// ============================================================
// TIẾN ĐỘ HỌC SINH
// ============================================================

// Đăng ký học chủ đề
model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  topicId     String
  enrolledAt  DateTime @default(now())
  completedAt DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id])

  @@unique([userId, topicId])
  @@map("enrollments")
}

// Tiến độ từng bài học
model LessonProgress {
  id             String    @id @default(cuid())
  userId         String
  lessonId       String
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  timeSpent      Int       @default(0) // Giây
  score          Float?    // Điểm bài tập trong bài học (0-100)
  lastAccessedAt DateTime  @default(now())
  createdAt      DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

// Flashcard review (Spaced Repetition - thuật toán SM-2)
model FlashcardReview {
  id           String   @id @default(cuid())
  userId       String
  vocabularyId String
  easeFactor   Float    @default(2.5)  // E-factor trong SM-2
  interval     Int      @default(0)    // Số ngày đến lần ôn tiếp
  repetitions  Int      @default(0)    // Số lần trả lời đúng liên tiếp
  nextReviewAt DateTime @default(now())
  lastQuality  Int?     // Chất lượng trả lời lần cuối (0-5)
  reviewCount  Int      @default(0)    // Tổng số lần đã ôn
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id])

  @@unique([userId, vocabularyId])
  @@index([userId, nextReviewAt])
  @@map("flashcard_reviews")
}

// ============================================================
// BÀI THI (EXAM ATTEMPT)
// ============================================================

model ExamAttempt {
  id          String    @id @default(cuid())
  userId      String
  examId      String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Float?    // Điểm sau chấm (null nếu chưa nộp)
  maxScore    Float?    // Tổng điểm tối đa
  percentage  Float?    // Phần trăm đúng
  isPassed    Boolean?  // Đạt hay không (nếu có passingScore)
  timeSpent   Int?      // Giây đã làm bài
  isAutoSubmit Boolean  @default(false) // Hết giờ tự nộp
  createdAt   DateTime  @default(now())

  user    User           @relation(fields: [userId], references: [id])
  exam    Exam           @relation(fields: [examId], references: [id])
  answers AttemptAnswer[]

  @@index([userId, examId])
  @@index([examId, submittedAt])
  @@map("exam_attempts")
}

// Câu trả lời từng câu trong một lần làm bài
model AttemptAnswer {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  answer     Json     // Dạng linh hoạt:
  // MULTIPLE_CHOICE:  { selectedOptionId: string }
  // MULTIPLE_SELECT:  { selectedOptionIds: string[] }
  // FILL_IN_BLANK:    { answers: string[] }
  // MATCHING:         { pairs: [{left, right}] }
  // ORDERING:         { order: string[] }
  // SHORT_ANSWER:     { text: string }
  // AUDIO_RESPONSE:   { audioUrl: string, transcript: string, pronunciationScore: number }

  isCorrect  Boolean?  // null nếu chờ chấm tay
  score      Float     @default(0)
  feedback   String?   // Nhận xét (cho câu hỏi chấm tay hoặc phát âm)
  answeredAt DateTime  @default(now())

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}

// ============================================================
// MEDIA FILES
// ============================================================

model MediaFile {
  id          String   @id @default(cuid())
  uploadedBy  String   // userId
  fileName    String
  fileType    String   // "audio" | "video" | "image"
  mimeType    String   // "audio/mpeg", "video/mp4", "image/jpeg"
  url         String   // URL công khai trên R2
  r2Key       String   // Key trong R2 bucket
  sizeBytes   Int
  duration    Int?     // Giây (cho audio/video)
  width       Int?     // pixels (cho image/video)
  height      Int?     // pixels (cho image/video)
  transcript  String?  @db.Text // Transcript audio (sau khi Whisper xử lý)
  createdAt   DateTime @default(now())

  @@map("media_files")
}

// ============================================================
// GAMIFICATION
// ============================================================

// Điểm XP tổng của học sinh
model UserXP {
  id         String   @id @default(cuid())
  userId     String   @unique
  totalXP    Int      @default(0)
  level      Int      @default(1)  // Tính từ totalXP
  weeklyXP   Int      @default(0)  // Reset mỗi tuần (qua Redis)
  monthlyXP  Int      @default(0)  // Reset mỗi tháng
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_xp")
}

// Lịch sử nhận XP (để hiển thị hoạt động)
model XPHistory {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String   // "lesson_complete", "exam_pass", "streak_bonus", v.v.
  refId     String?  // ID bài học/đề thi liên quan
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("xp_history")
}

// Định nghĩa huy hiệu
model Badge {
  id          String    @id @default(cuid())
  name        String    @unique
  description String
  imageUrl    String
  type        BadgeType
  condition   Json      // Điều kiện nhận:
  // STREAK:      { days: number }
  // MASTERY:     { topicId: string }
  // SCORE:       { minScore: number, examType: ExamType }
  // SPEED:       { maxTime: number, minScore: number }
  // CONSISTENCY: { lessonsPerWeek: number, weeks: number }
  xpReward    Int       @default(0)
  createdAt   DateTime  @default(now())

  userBadges  UserBadge[]

  @@map("badges")
}

// Huy hiệu học sinh đã nhận
model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  earnedAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// Chuỗi ngày học liên tiếp
model Streak {
  id            String    @id @default(cuid())
  userId        String    @unique
  currentStreak Int       @default(0)  // Chuỗi hiện tại
  longestStreak Int       @default(0)  // Chuỗi dài nhất
  lastStudyDate DateTime? // Ngày học gần nhất
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}
